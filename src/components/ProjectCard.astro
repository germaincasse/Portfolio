---
import SteamIcon from './SteamIcon.astro';
import { asset, pad, isSteam } from '../utils';

interface Props {
  slug: string;
  index: number;
  title: string;
  tagline: string;
  role: string;
  engine: string;
  year: string;
  status?: string;
  tags: readonly string[];
  cover?: string;
  poster: string;
  preview?: string;
  accent: string;
  links?: readonly { label: string; url: string }[];
}

const {
  slug,
  index,
  title,
  tagline,
  role,
  engine,
  year,
  status,
  tags,
  cover,
  poster,
  preview,
  accent,
  links = [],
} = Astro.props;
---

<a
  class="card reveal"
  href={asset(`/work/${slug}`)}
  style={`--accent: ${accent};`}
  aria-label={`${title}: ${tagline}`}
>
  <div class="card__media">
    {/* L'illustration est ce qu'on voit par defaut: elle ne bouge pas tant que
        la souris n'est pas sur la carte. */}
    <img
      class="card__still"
      src={asset(preview ?? poster)}
      alt=""
      loading="lazy"
      decoding="async"
    />
    {
      cover && (
        <video
          class="card__clip"
          data-hover-video
          data-src={asset(cover)}
          preload="none"
          muted
          loop
          playsinline
          aria-hidden="true"
          tabindex="-1"
        />
      )
    }
    <span class="card__index mono">{pad(index)}</span>
    <span class="card__view mono">View<span aria-hidden="true"> →</span></span>
  </div>

  <div class="card__foot">
    <div class="card__heading">
      <h3 class="card__title display">{title}</h3>
      {
        status && (
          <p class="card__status mono" data-status={status}>
            <span class="card__status-dot" aria-hidden="true" />
            {status}
          </p>
        )
      }
    </div>
    <p class="card__meta mono">
      {role} <span aria-hidden="true">/</span> {engine} <span aria-hidden="true">/</span> {year}
      {links.some((l) => isSteam(l.url)) && (
        <>
          <SteamIcon class="card__steam" />
          <span class="sr-only">Available on Steam</span>
        </>
      )}
    </p>
    <p class="card__tagline">{tagline}</p>
    <ul class="tags mono">
      {tags.map((t) => <li class="tag">{t}</li>)}
    </ul>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
  }

  .card__media {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--bg-sunken);
    border-radius: 3px;
  }

  .card__still,
  .card__clip {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Seul transform est anime: une transition sur filter repeint l'image entiere
     a chaque frame, transform reste sur le GPU. */
  .card__still {
    transform: scale(1.005);
    transition: transform 0.8s var(--ease);
  }

  /* La video reste invisible tant que le survol ne l'a pas lancee. */
  .card__clip {
    opacity: 0;
    transition: opacity 0.45s var(--ease);
  }

  .card.is-playing .card__clip {
    opacity: 1;
  }

  .card:hover .card__still,
  .card:focus-visible .card__still {
    transform: scale(1.03);
  }

  /* Voile discret qui s'estompe au survol. */
  .card__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--bg) 55%, transparent),
      transparent 50%
    );
    opacity: 1;
    transition: opacity 0.6s var(--ease);
    pointer-events: none;
  }

  .card:hover .card__media::after {
    opacity: 0.25;
  }

  .card__index {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 2;
    padding: 0.3rem 0.5rem;
    /* Fond opaque plutot qu'un backdrop-filter: le flou etait recalcule a chaque
       frame de la video qui passe dessous. */
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    color: var(--accent);
    border-radius: 2px;
  }

  .card__view {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    z-index: 2;
    padding: 0.45rem 0.7rem;
    background: var(--accent);
    color: #08080a;
    border-radius: 2px;
    opacity: 0;
    transform: translateY(0.4rem);
    transition:
      opacity 0.4s var(--ease),
      transform 0.4s var(--ease);
  }

  .card:hover .card__view,
  .card:focus-visible .card__view {
    opacity: 1;
    transform: none;
  }

  .card__foot {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0.5rem 1rem;
    padding-top: clamp(0.9rem, 1.5vw, 1.25rem);
  }

  .card__heading {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-width: 0;
  }

  .card__title {
    font-size: clamp(1.5rem, 2.4vw, 2.5rem);
    font-stretch: 106%;
    transition: color 0.35s var(--ease);
  }

  /* Sous-titre d'etat. La couleur est portee par le point, le texte reste
     sobre: une ligne entiere en couleur vive se battrait avec l'accent du
     projet juste au-dessus. */
  .card__status {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--text-dim);
  }

  .card__status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--status-color, var(--text-faint));
    flex: none;
  }

  .card__status[data-status='Released'] {
    --status-color: #4ade80;
  }

  .card__status[data-status='Demo'] {
    --status-color: #5aa8d6;
  }

  .card__status[data-status='In development'] {
    --status-color: #e0a03c;
  }

  .card__status[data-status='Unreleased'] {
    --status-color: #66655f;
  }

  .card:hover .card__title,
  .card:focus-visible .card__title {
    color: var(--accent);
  }

  .card__meta {
    color: var(--text-faint);
    text-align: right;
    white-space: nowrap;
  }

  .card__steam {
    margin-left: 0.55rem;
    color: var(--text-dim);
    vertical-align: -0.2em;
  }

  .card:hover .card__steam,
  .card:focus-visible .card__steam {
    color: var(--accent);
  }

  .card__tagline {
    grid-column: 1 / -1;
    color: var(--text-dim);
    font-size: 0.9375rem;
    max-width: 52ch;
  }

  .card__foot .tags {
    grid-column: 1 / -1;
  }

  @media (max-width: 44rem) {
    .card__foot {
      grid-template-columns: 1fr;
    }
    .card__meta {
      text-align: left;
    }
    .card__view {
      opacity: 1;
      transform: none;
    }
  }
</style>
