---
import { asset, pad } from '../utils';

interface Props {
  slug: string;
  index: number;
  title: string;
  tagline: string;
  role: string;
  engine: string;
  year: number;
  tags: readonly string[];
  cover?: string;
  poster: string;
  accent: string;
}

const {
  slug,
  index,
  title,
  tagline,
  role,
  engine,
  year,
  tags,
  cover,
  poster,
  accent,
} = Astro.props;
---

<a
  class="card reveal"
  href={asset(`/work/${slug}`)}
  style={`--accent: ${accent};`}
  aria-label={`${title} — ${tagline}`}
>
  <div class="card__media">
    {/* L'illustration est ce qu'on voit par defaut: elle ne bouge pas tant que
        la souris n'est pas sur la carte. */}
    <img
      class="card__still"
      src={asset(poster)}
      alt=""
      loading="lazy"
      decoding="async"
    />
    {
      cover && (
        <video
          class="card__clip"
          data-hover-video
          data-src={asset(cover)}
          preload="none"
          muted
          loop
          playsinline
          aria-hidden="true"
          tabindex="-1"
        />
      )
    }
    <span class="card__index mono">{pad(index)}</span>
    <span class="card__view mono">View<span aria-hidden="true"> →</span></span>
  </div>

  <div class="card__foot">
    <h3 class="card__title display">{title}</h3>
    <p class="card__meta mono">{role} <span aria-hidden="true">/</span> {engine} <span aria-hidden="true">/</span> {year}</p>
    <p class="card__tagline">{tagline}</p>
    <ul class="tags mono">
      {tags.map((t) => <li class="tag">{t}</li>)}
    </ul>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
  }

  .card__media {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--bg-sunken);
    border-radius: 3px;
  }

  .card__still,
  .card__clip {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card__still {
    transform: scale(1.005);
    filter: saturate(0.9) contrast(1.02);
    transition:
      transform 0.8s var(--ease),
      filter 0.6s var(--ease);
  }

  /* La video reste invisible tant que le survol ne l'a pas lancee. */
  .card__clip {
    opacity: 0;
    transition: opacity 0.45s var(--ease);
  }

  .card.is-playing .card__clip {
    opacity: 1;
  }

  .card:hover .card__still,
  .card:focus-visible .card__still {
    transform: scale(1.03);
    filter: saturate(1) contrast(1.02);
  }

  /* Voile discret qui s'estompe au survol. */
  .card__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--bg) 55%, transparent),
      transparent 50%
    );
    opacity: 1;
    transition: opacity 0.6s var(--ease);
    pointer-events: none;
  }

  .card:hover .card__media::after {
    opacity: 0.25;
  }

  .card__index {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 2;
    padding: 0.3rem 0.5rem;
    background: color-mix(in srgb, var(--bg) 70%, transparent);
    backdrop-filter: blur(6px);
    color: var(--accent);
    border-radius: 2px;
  }

  .card__view {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    z-index: 2;
    padding: 0.45rem 0.7rem;
    background: var(--accent);
    color: #08080a;
    border-radius: 2px;
    opacity: 0;
    transform: translateY(0.4rem);
    transition:
      opacity 0.4s var(--ease),
      transform 0.4s var(--ease);
  }

  .card:hover .card__view,
  .card:focus-visible .card__view {
    opacity: 1;
    transform: none;
  }

  .card__foot {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0.5rem 1rem;
    padding-top: clamp(0.9rem, 1.5vw, 1.25rem);
  }

  .card__title {
    font-size: clamp(1.5rem, 2.4vw, 2.5rem);
    font-stretch: 106%;
    transition: color 0.35s var(--ease);
  }

  .card:hover .card__title,
  .card:focus-visible .card__title {
    color: var(--accent);
  }

  .card__meta {
    color: var(--text-faint);
    text-align: right;
    white-space: nowrap;
  }

  .card__tagline {
    grid-column: 1 / -1;
    color: var(--text-dim);
    font-size: 0.9375rem;
    max-width: 52ch;
  }

  .card__foot .tags {
    grid-column: 1 / -1;
  }

  @media (max-width: 44rem) {
    .card__foot {
      grid-template-columns: 1fr;
    }
    .card__meta {
      text-align: left;
    }
    .card__view {
      opacity: 1;
      transform: none;
    }
  }
</style>
