---
interface Props {
  index: string;
  title: string;
  note?: string;
  id?: string;
}
const { index, title, note, id } = Astro.props;
---

<div class="section-head" id={id}>
  <span class="section-head__index mono">({index})</span>
  <h2 class="section-head__title display">{title}</h2>
  {note && <p class="section-head__note mono">{note}</p>}
</div>
