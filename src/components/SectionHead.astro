---
interface Props {
  index: string;
  /** Numero en mode apercu, quand une section secrete le decale (PreviewMode). */
  previewIndex?: string;
  title: string;
  id?: string;
}
const { index, previewIndex, title, id } = Astro.props;
---

<div class="section-head" id={id}>
  <span
    class="section-head__index mono"
    data-preview-text={previewIndex && previewIndex !== index ? `(${previewIndex})` : undefined}
    >({index})</span
  >
  <h2 class="section-head__title display">{title}</h2>
</div>
