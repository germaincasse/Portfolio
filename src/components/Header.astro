---
import { site } from '../site';
import { asset } from '../utils';

const path = Astro.url.pathname.replace(/\/$/, '');
const isActive = (href: string) =>
  href.startsWith('/#') ? false : path.endsWith(href.replace(/\/$/, ''));
---

<header class="hdr">
  <div class="hdr__inner wrap">
    <a class="hdr__brand mono" href={asset('/')}>
      <span class="hdr__dot" aria-hidden="true"></span>
      {site.shortName}
    </a>

    <nav class="hdr__nav mono" aria-label="Main">
      {
        site.nav.map((item) => (
          <a
            href={asset(item.href)}
            class:list={['hdr__link', { 'is-active': isActive(item.href) }]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    border-bottom: 1px solid var(--line-soft);
  }

  .hdr__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: 4rem;
  }

  .hdr__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--text);
    white-space: nowrap;
  }

  .hdr__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 60%, transparent);
    animation: pulse 3s var(--ease) infinite;
  }

  @keyframes pulse {
    0%,
    70%,
    100% {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 55%, transparent);
    }
    35% {
      box-shadow: 0 0 0 6px transparent;
    }
  }

  .hdr__nav {
    display: flex;
    gap: clamp(1rem, 3vw, 2.5rem);
  }

  .hdr__link {
    color: var(--text-dim);
    transition: color 0.25s var(--ease);
  }

  .hdr__link:hover,
  .hdr__link.is-active {
    color: var(--text);
  }

  .hdr__link.is-active {
    color: var(--accent);
  }

  @media (max-width: 30rem) {
    .hdr__brand {
      font-size: 0.625rem;
    }
    .hdr__nav {
      font-size: 0.625rem;
      gap: 1rem;
    }
  }
</style>
