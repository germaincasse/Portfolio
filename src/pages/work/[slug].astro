---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SteamIcon from '../../components/SteamIcon.astro';
import { asset, pad, isSteam } from '../../utils';

export async function getStaticPaths() {
  const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
    (a, b) => a.data.order - b.data.order,
  );

  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: {
      project,
      index: i + 1,
      next: projects[(i + 1) % projects.length],
    },
  }));
}

const { project, index, next } = Astro.props;
const d = project.data;
const { Content } = await render(project);

// Le poster sert deja de visuel principal: pas la peine de le repeter en galerie.
const gallery = d.gallery.filter((src) => src !== d.poster);
---

<Base
  title={d.title}
  description={d.tagline}
  ogImage={d.poster}
  accent={d.accent}
>
  <article class="project">
    <!-- Ecran d'ouverture: le gameplay tient tout l'ecran, le titre est pose
         dessus, et tout remonte normalement au scroll. -->
    <header class="stage">
      <div class="stage__media" aria-hidden="true">
        {
          d.cover ? (
            <video
              data-lazy
              data-src={asset(d.cover)}
              poster={asset(d.poster)}
              preload="none"
              muted
              loop
              playsinline
              tabindex="-1"
            />
          ) : (
            <img src={asset(d.poster)} alt="" />
          )
        }
      </div>

      <div class="wrap stage__inner">
        <a class="back mono" href={asset('/#work')}>
          <span aria-hidden="true">←</span> All projects
        </a>

        <div class="stage__bottom">
          <p class="mono project__index">({pad(index)})</p>
          <h1 class="project__title display">{d.title}</h1>
          <p class="project__tagline">{d.tagline}</p>
        </div>
      </div>
    </header>

    <!-- Meta + texte -->
    <div class="wrap project__grid">
      <aside class="meta">
        <dl class="meta__list mono">
          <div class="meta__row">
            <dt>Type</dt>
            <dd>{d.role}</dd>
          </div>
          <div class="meta__row">
            <dt>Engine</dt>
            <dd>{d.engine}</dd>
          </div>
          <div class="meta__row">
            <dt>Year</dt>
            <dd>{d.year}</dd>
          </div>
          <div class="meta__row">
            <dt>Tags</dt>
            <dd>
              <ul class="tags">
                {d.tags.map((t) => <li class="tag">{t}</li>)}
              </ul>
            </dd>
          </div>
        </dl>

        {
          d.links.length > 0 && (
            <ul class="meta__links mono">
              {d.links.map((l) => (
                <li>
                  <a
                    class="meta__link"
                    href={l.url}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {isSteam(l.url) && <SteamIcon />}
                    <span class="link-underline">{l.label}</span>
                    <span aria-hidden="true">↗</span>
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </aside>

      <div class="prose">
        <Content />
      </div>
    </div>

    <!-- Galerie -->
    {
      gallery.length > 0 && (
        <div class="wrap gallery">
          {gallery.map((src) => (
            <figure class="gallery__item reveal">
              <img
                src={asset(src)}
                alt={`${d.title} screenshot`}
                loading="lazy"
                decoding="async"
              />
            </figure>
          ))}
        </div>
      )
    }

    <!-- Projet suivant -->
    <a class="next" href={asset(`/work/${next.id}`)} style={`--accent: ${next.data.accent};`}>
      <div class="wrap next__inner">
        <p class="mono next__label">Next project</p>
        <p class="next__title display">{next.data.title}</p>
        <p class="mono next__arrow" aria-hidden="true">→</p>
      </div>
    </a>
  </article>
</Base>

<style>
  /* 4rem = hauteur du header sticky, pour que l'ouverture fasse exactement un
     ecran sans deborder. */
  .stage {
    position: relative;
    display: flex;
    min-height: calc(100svh - 4rem);
    overflow: hidden;
    isolation: isolate;
  }

  .stage__media {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--bg-sunken);
  }

  .stage__media video,
  .stage__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Fondu vers le noir en bas: le titre reste lisible et l'image se raccorde
     au fond de la page qui suit. */
  .stage__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      var(--bg) 1%,
      color-mix(in srgb, var(--bg) 55%, transparent) 45%,
      color-mix(in srgb, var(--bg) 15%, transparent) 100%
    );
  }

  .stage__inner {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 3rem;
    width: 100%;
    padding-block: clamp(1.5rem, 4vh, 2.5rem) clamp(2.5rem, 7vh, 5rem);
  }

  .back {
    align-self: flex-start;
    color: var(--text-dim);
    transition: color 0.3s var(--ease);
  }

  .back:hover {
    color: var(--accent);
  }

  .project__index {
    color: var(--accent);
    margin-bottom: 0.75rem;
  }

  .project__title {
    font-size: clamp(2.75rem, 12vw, 11rem);
    font-stretch: 115%;
  }

  .project__tagline {
    margin-top: 1.5rem;
    max-width: 56ch;
    font-size: clamp(1.0625rem, 1.6vw, 1.375rem);
    color: var(--text);
  }

  .project__grid {
    display: grid;
    grid-template-columns: minmax(0, 18rem) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 6rem);
    padding-block: clamp(3rem, 8vw, 6rem);
  }

  .meta__list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin: 0;
    padding-top: 0.5rem;
    border-top: 1px solid var(--line);
  }

  .meta__row {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: 1rem;
    padding-top: 0.75rem;
  }

  .meta__row dt {
    color: var(--text-faint);
  }

  .meta__row dd {
    margin: 0;
    color: var(--text);
  }

  .meta__links {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    list-style: none;
    padding: 1.5rem 0 0;
    margin: 1.5rem 0 0;
    border-top: 1px solid var(--line-soft);
  }

  .meta__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--accent);
  }

  /* Contenu markdown */
  .prose {
    max-width: 68ch;
    font-size: clamp(1.0625rem, 1.3vw, 1.1875rem);
    color: var(--text-dim);
  }

  .prose :global(p) {
    margin-bottom: 1.25em;
  }

  .prose :global(p:first-child) {
    color: var(--text);
    font-size: 1.15em;
    line-height: 1.5;
  }

  .prose :global(h2) {
    margin: 2.5em 0 0.8em;
    font-size: 0.6875rem;
    font-family: var(--font-mono);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    padding-top: 1rem;
    border-top: 1px solid var(--line-soft);
  }

  .prose :global(h3) {
    margin: 2em 0 0.6em;
    font-size: 1.125rem;
    color: var(--text);
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 1.25em;
    padding-left: 1.2em;
  }

  .prose :global(li) {
    margin-bottom: 0.4em;
  }

  .prose :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
    padding: 0.15em 0.4em;
    background: var(--bg-raise);
    border: 1px solid var(--line-soft);
    border-radius: 2px;
  }

  .prose :global(img) {
    width: 100%;
    border-radius: 3px;
    margin-block: 2em;
  }

  .prose :global(blockquote) {
    margin: 2em 0;
    padding-left: 1.25em;
    border-left: 2px solid var(--accent);
    color: var(--text);
  }

  /* Galerie */
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 26rem), 1fr));
    gap: clamp(0.75rem, 2vw, 1.5rem);
    padding-bottom: clamp(3rem, 8vw, 6rem);
  }

  .gallery__item {
    margin: 0;
    overflow: hidden;
    border-radius: 3px;
    background: var(--bg-sunken);
  }

  .gallery__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Next */
  .next {
    display: block;
    border-top: 1px solid var(--line);
    transition: background 0.4s var(--ease);
  }

  .next:hover {
    background: var(--bg-raise);
  }

  .next__inner {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 0.5rem 2rem;
    padding-block: clamp(2.5rem, 7vw, 5rem);
  }

  .next__label {
    grid-column: 1;
    color: var(--text-faint);
    margin-bottom: 0.5rem;
  }

  .next__title {
    grid-column: 1;
    grid-row: 2;
    font-size: clamp(2rem, 7vw, 5.5rem);
    font-stretch: 110%;
    transition: color 0.35s var(--ease);
  }

  .next:hover .next__title {
    color: var(--accent);
  }

  .next__arrow {
    grid-column: 2;
    grid-row: 1 / -1;
    font-size: 1.5rem;
    color: var(--accent);
    transition: transform 0.4s var(--ease);
  }

  .next:hover .next__arrow {
    transform: translateX(0.75rem);
  }

  @media (max-width: 60rem) {
    .project__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
