---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SlotTitle from '../components/SlotTitle.astro';
import { site } from '../site';
import { asset } from '../utils';

// Tous les projets sont sur la home: c'est la seule page qui les liste.
const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Base>
  <!-- ================= HERO ================= -->
  <section class="hero">
    <div class="hero__bg" aria-hidden="true">
      <video
        data-lazy
        data-src={asset('/media/home/reel.mp4')}
        poster={asset('/media/zero-g-chef/shot-01.webp')}
        preload="none"
        muted
        loop
        playsinline
        tabindex="-1"></video>
    </div>

    <div class="wrap hero__inner">
      <p class="mono hero__eyebrow">
        <span class="hero__eyebrow-dot" aria-hidden="true"></span>
        {site.role} &middot; Unity &amp; Godot &middot; {site.availability}
      </p>

      <h1 class="hero__title display" aria-label={site.name}>
        <SlotTitle text={site.name} />
      </h1>

      <div class="hero__bottom">
        <a class="hero__scroll mono" href="#work">
          Projects <span aria-hidden="true">↓</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ================= WORK ================= -->
  <section class="section wrap" id="work">
    <SectionHead
      index="01"
      title="Projects"
      note="Client and personal projects, PC and mobile."
    />

    <div class="cards">
      {
        projects.map((p, i) => (
          <ProjectCard
            slug={p.id}
            index={i + 1}
            title={p.data.title}
            tagline={p.data.tagline}
            role={p.data.role}
            engine={p.data.engine}
            year={p.data.year}
            tags={p.data.tags}
            cover={p.data.cover}
            poster={p.data.poster}
            accent={p.data.accent}
          />
        ))
      }
    </div>

  </section>

  <!-- ================= CAPABILITIES ================= -->
  <section class="section wrap">
    <SectionHead
      index="02"
      title="What I do"
      note="What I take on, and what I use."
    />

    <ul class="caps">
      {
        site.capabilities.map((c) => (
          <li class="cap reveal">
            <img
              class="cap__icon"
              src={asset(c.icon)}
              alt=""
              width="64"
              height="64"
              loading="lazy"
              decoding="async"
            />
            <h3 class="cap__title">{c.title}</h3>
            <p class="cap__body">{c.body}</p>
            <ul class="tags mono cap__stack">
              {c.stack.map((s) => (
                <li class="tag">{s}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ================= ABOUT ================= -->
  <section class="section wrap" id="about">
    <SectionHead index="03" title="About" />

    <div class="about reveal">
      <p class="about__lead">{site.about.lead}</p>
      <div class="about__body">
        {site.about.body.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------------- Hero ---------------- */
  .hero {
    position: relative;
    min-height: min(92svh, 60rem);
    display: flex;
    align-items: flex-end;
    padding-block: clamp(4rem, 14vh, 9rem) clamp(2rem, 6vh, 4rem);
    overflow: hidden;
    isolation: isolate;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  /* L'etalonnage est encode dans le mp4 (voir scripts/media.mjs): un filter CSS
     sur une video plein ecran se repaie a chaque frame de lecture. */
  .hero__bg video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.92;
  }

  .hero__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    /* Plus de voile global: seulement un fondu dans le bas de l'ecran, la ou se
       posent le titre et l'intro, et pour raccorder au fond de la page. */
    background: linear-gradient(
      to top,
      var(--bg) 0%,
      color-mix(in srgb, var(--bg) 55%, transparent) 22%,
      transparent 50%
    );
  }

  .hero__inner {
    width: 100%;
  }

  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--text-dim);
    margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
  }

  .hero__eyebrow-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  /* "GERMAIN CASSE" tient sur une ligne des qu'il y a la place; en dessous,
     le titre passe a la ligne tout seul (flex-wrap dans SlotTitle). */
  .hero__title {
    font-size: clamp(2.5rem, 11vw, 11rem);
    font-stretch: 112%;
  }

  .hero__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    margin-top: clamp(2rem, 6vw, 4rem);
    padding-top: clamp(1.5rem, 3vw, 2rem);
    border-top: 1px solid var(--line);
  }

  /* Les petits textes passent sur l'image sans voile pour les proteger: une
     ombre diffuse suffit a les detacher. Le titre, lui, n'en prend pas: son
     masque de defilement couperait l'ombre au bord de chaque lettre. */
  .hero__eyebrow,
  .hero__scroll {
    text-shadow: 0 1px 16px color-mix(in srgb, var(--bg) 80%, transparent);
  }

  .hero__scroll {
    color: var(--text);
    white-space: nowrap;
    border: 1px solid var(--line);
    padding: 0.7rem 1.1rem;
    border-radius: 2px;
    transition:
      background 0.3s var(--ease),
      color 0.3s var(--ease),
      border-color 0.3s var(--ease);
  }

  .hero__scroll:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: #08080a;
  }

  /* ---------------- Sections ---------------- */
  .section {
    padding-block: var(--section-gap) 0;
  }

  .section:last-of-type {
    padding-bottom: var(--section-gap);
  }

  /* Deux colonnes: les illustrations occupent presque toute la largeur utile,
     la gouttiere reste fine pour ne pas casser le bloc. */
  .cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.75rem, 3.5vw, 3.5rem) clamp(1rem, 1.6vw, 1.5rem);
  }

  @media (max-width: 48rem) {
    .cards {
      grid-template-columns: 1fr;
    }
  }

  /* ---------------- Capabilities ---------------- */
  .caps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: 1px;
    list-style: none;
    padding: 0;
    margin: 0;
    background: var(--line-soft);
    border: 1px solid var(--line-soft);
  }

  .cap {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    background: var(--bg);
    transition: background 0.4s var(--ease);
  }

  .cap:hover {
    background: var(--bg-raise);
  }

  .cap__icon {
    width: 4rem;
    height: 4rem;
    object-fit: contain;
    opacity: 0.7;
    transition: opacity 0.4s var(--ease);
  }

  .cap:hover .cap__icon {
    opacity: 1;
  }

  .cap__title {
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: -0.015em;
  }

  .cap__body {
    color: var(--text-dim);
    font-size: 0.9375rem;
    flex: 1;
  }

  .cap__stack {
    margin-top: auto;
  }

  /* ---------------- About ---------------- */
  .about {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: clamp(2rem, 6vw, 5rem);
  }

  .about__lead {
    max-width: 20ch;
    font-size: clamp(1.5rem, 3.2vw, 2.75rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .about__body {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-width: 62ch;
    color: var(--text-dim);
  }

  /* Le premier paragraphe est le plus lu: il reste en blanc. */
  .about__body p:first-child {
    color: var(--text);
  }

  @media (max-width: 52rem) {
    .about {
      grid-template-columns: 1fr;
    }
  }
</style>
